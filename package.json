{
  "name": "losthusky-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute losthusky_inbox --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute losthusky_inbox --file=./schema.sql --local",
    "hash-password": "node scripts/hash-password.mjs",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
  },
  "devDependencies": {
    "wrangler": "^4.106.0"
  }
}
