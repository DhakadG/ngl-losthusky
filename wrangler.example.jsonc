{
  // Copy this file to `wrangler.jsonc` and fill in the real IDs.
  // `wrangler.jsonc` is gitignored so your resource IDs never hit GitHub.
  "name": "losthusky-inbox",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Worker handles these first; everything else (including /admin) is
    // served directly from public/ by the assets layer's own clean-URL
    // resolution. Do NOT add /admin here — routing it through the Worker
    // and re-fetching admin.html causes an infinite redirect loop, because
    // the assets layer 307-redirects requests for the .html path back to
    // the extensionless path.
    "run_worker_first": ["/api/*"],
    // Unknown paths (e.g. /my-slug) fall back to the send page.
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "losthusky_inbox",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "vars": {
    // Public, non-secret config only. Secrets go in .dev.vars / `wrangler secret`.
    "OWNER_HANDLE": "losthusky",
    // Notify me on views too. Set "false" to only notify on messages.
    "NOTIFY_ON_VIEW": "true"
  },

  "routes": [{ "pattern": "ngl.losthusky.qzz.io", "custom_domain": true }]
}
